[appearance.colors]
background = "#{{colors.surface.default.hex_stripped}}"
sidebar = "#{{colors.surface_container.default.hex_stripped}}"
surface = "#{{colors.surface_container_high.default.hex_stripped}}"
text_primary = "#{{colors.on_surface.default.hex_stripped}}"
text_muted = "#{{colors.on_surface_variant.default.hex_stripped}}"
accent_primary = "#{{colors.primary.default.hex_stripped}}"
accent_secondary = "#{{colors.secondary.default.hex_stripped}}"
accent_tertiary = "#{{colors.tertiary.default.hex_stripped}}"
accent_text = "#{{colors.on_primary.default.hex_stripped}}"
error = "#{{colors.error.default.hex_stripped}}"
error_text = "#{{colors.on_error.default.hex_stripped}}"

[appearance.colors.border]
focused = "#{{colors.primary.default.hex_stripped}}"
unfocused = "#{{colors.outline_variant.default.hex_stripped}}"
outer = "#{{colors.outline.default.hex_stripped}}"
